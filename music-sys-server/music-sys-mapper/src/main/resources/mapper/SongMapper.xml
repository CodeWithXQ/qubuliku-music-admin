<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.musicsys.mapper.SongMapper">

    <resultMap id="SongVoMap" type="com.musicsys.model.vo.SongVo">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="singerId" column="singer_id"/>
        <result property="singerName" column="singer_name"/>
        <result property="album" column="album"/>
        <result property="style" column="style"/>
        <result property="duration" column="duration"/>
        <result property="isrc" column="isrc"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="audioUrl" column="audio_url"/>
        <result property="lyric" column="lyric"/>
        <result property="playCount" column="play_count"/>
        <result property="auditStatus" column="audit_status"/>
        <result property="auditorId" column="auditor_id"/>
        <result property="auditTime" column="audit_time"/>
        <result property="auditRemark" column="audit_remark"/>
        <result property="audioFingerprint" column="audio_fingerprint"/>
        <result property="releaseDate" column="release_date"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectPageWithSinger" resultMap="SongVoMap">
        SELECT s.*, si.name AS singer_name
        FROM song s
        LEFT JOIN singer si ON s.singer_id = si.id
        <where>
            <if test="query.keyword != null and query.keyword != ''">
                AND (s.title LIKE CONCAT('%', #{query.keyword}, '%')
                     OR si.name LIKE CONCAT('%', #{query.keyword}, '%'))
            </if>
            <if test="query.style != null and query.style != ''">
                AND s.style = #{query.style}
            </if>
            <if test="query.auditStatus != null and query.auditStatus != ''">
                AND s.audit_status = #{query.auditStatus}
            </if>
        </where>
        ORDER BY s.updated_at DESC
    </select>

    <select id="selectByIdWithSinger" resultMap="SongVoMap">
        SELECT s.*, si.name AS singer_name
        FROM song s
        LEFT JOIN singer si ON s.singer_id = si.id
        WHERE s.id = #{id}
    </select>

</mapper>
