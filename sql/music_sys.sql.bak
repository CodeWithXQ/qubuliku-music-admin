-- ============================================================
-- 曲不离库 · 音乐后台智能管理系统 — 完整数据库建表脚本
-- 版本: 1.0.0
-- 数据库: MySQL 8.0+
-- 字符集: utf8mb4
-- 对齐: 前端 admin-ui (Vue3 + TypeScript) 已实现的数据模型
-- ============================================================

DROP DATABASE IF EXISTS music_sys;
CREATE DATABASE music_sys CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE music_sys;

-- ============================================================
-- 第一部分：系统权限模块 (RBAC)
-- ============================================================

-- 1. 后台管理员
CREATE TABLE sys_user (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT  COMMENT '管理员ID',
    username        VARCHAR(50)     NOT NULL UNIQUE             COMMENT '登录名',
    password        VARCHAR(255)    NOT NULL                    COMMENT '加密密码(BCrypt)',
    avatar          TEXT            DEFAULT NULL                COMMENT '头像(支持dataURI)',
    real_name       VARCHAR(50)     DEFAULT NULL                COMMENT '真实姓名',
    employee_id     VARCHAR(20)     DEFAULT NULL                COMMENT '工号',
    position        VARCHAR(50)     DEFAULT NULL                COMMENT '职务',
    department      VARCHAR(50)     DEFAULT NULL                COMMENT '所属部门',
    phone           VARCHAR(20)     DEFAULT NULL                COMMENT '手机号',
    status          TINYINT         NOT NULL DEFAULT 1          COMMENT '账号状态: 0禁用 / 1正常 / 2待激活',
    last_login_ip   VARCHAR(50)     DEFAULT NULL                COMMENT '最后登录IP',
    last_login_time DATETIME        DEFAULT NULL                COMMENT '最后登录时间',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_sys_user_status (status),
    INDEX idx_sys_user_department (department)
) ENGINE=InnoDB COMMENT='后台管理员';

-- 2. 角色表
CREATE TABLE sys_role (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT  COMMENT '角色ID',
    role_code       VARCHAR(30)     NOT NULL UNIQUE             COMMENT '角色编码(admin/editor/auditor)',
    role_name       VARCHAR(50)     NOT NULL                    COMMENT '角色名称',
    description     VARCHAR(200)    DEFAULT NULL                COMMENT '角色描述',
    status          TINYINT         NOT NULL DEFAULT 1          COMMENT '状态: 0禁用 / 1正常',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB COMMENT='RBAC角色';

-- 3. 权限表
CREATE TABLE sys_permission (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT  COMMENT '权限ID',
    perm_code       VARCHAR(50)     NOT NULL UNIQUE             COMMENT '权限编码(dashboard:view等)',
    perm_name       VARCHAR(50)     NOT NULL                    COMMENT '权限名称',
    perm_type       TINYINT         NOT NULL DEFAULT 0          COMMENT '类型: 0菜单 / 1按钮 / 2接口',
    parent_id       BIGINT          DEFAULT NULL                COMMENT '上级权限ID(树形)',
    path            VARCHAR(100)    DEFAULT NULL                COMMENT '对应路由或接口路径',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_perm_parent (parent_id),
    CONSTRAINT fk_perm_parent FOREIGN KEY (parent_id) REFERENCES sys_permission(id) ON DELETE SET NULL
) ENGINE=InnoDB COMMENT='RBAC权限';

-- 4. 用户-角色关联
CREATE TABLE sys_user_role (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT,
    user_id         BIGINT          NOT NULL,
    role_id         BIGINT          NOT NULL,
    UNIQUE KEY uk_user_role (user_id, role_id),
    CONSTRAINT fk_ur_user FOREIGN KEY (user_id) REFERENCES sys_user(id) ON DELETE CASCADE,
    CONSTRAINT fk_ur_role FOREIGN KEY (role_id) REFERENCES sys_role(id) ON DELETE CASCADE
) ENGINE=InnoDB COMMENT='用户角色关联';

-- 5. 角色-权限关联
CREATE TABLE sys_role_permission (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT,
    role_id         BIGINT          NOT NULL,
    perm_id         BIGINT          NOT NULL,
    UNIQUE KEY uk_role_perm (role_id, perm_id),
    CONSTRAINT fk_rp_role FOREIGN KEY (role_id) REFERENCES sys_role(id) ON DELETE CASCADE,
    CONSTRAINT fk_rp_perm FOREIGN KEY (perm_id) REFERENCES sys_permission(id) ON DELETE CASCADE
) ENGINE=InnoDB COMMENT='角色权限关联';

-- ============================================================
-- 第二部分：核心业务模块
-- ============================================================

-- 6. 歌手表
CREATE TABLE singer (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT  COMMENT '歌手ID',
    name            VARCHAR(100)    NOT NULL                    COMMENT '歌手名称',
    avatar          TEXT            DEFAULT NULL                COMMENT '头像(支持dataURI)',
    style           VARCHAR(20)     DEFAULT NULL                COMMENT '音乐风格: 流行/摇滚/电子/民谣/嘻哈/古典',
    cert_status     TINYINT         NOT NULL DEFAULT 0          COMMENT '认证状态: 0入驻中 / 1待认证 / 2已认证',
    intro           TEXT            DEFAULT NULL                COMMENT '歌手简介',
    social_links    TEXT            DEFAULT NULL                COMMENT '社交媒体链接(逗号分隔)',
    song_count      INT             NOT NULL DEFAULT 0          COMMENT '作品数量(冗余)',
    follower_count  INT             NOT NULL DEFAULT 0          COMMENT '粉丝数量(冗余)',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_singer_style (style),
    INDEX idx_singer_cert (cert_status),
    INDEX idx_singer_name (name)
) ENGINE=InnoDB COMMENT='歌手';

-- 7. 歌曲表
CREATE TABLE song (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT  COMMENT '歌曲ID',
    title           VARCHAR(200)    NOT NULL                    COMMENT '歌曲名称',
    singer_id       BIGINT          NOT NULL                    COMMENT '歌手ID',
    album           VARCHAR(200)    DEFAULT NULL                COMMENT '所属专辑',
    style           VARCHAR(20)     DEFAULT NULL                COMMENT '音乐风格',
    duration        INT             DEFAULT NULL                COMMENT '时长(秒)',
    isrc            VARCHAR(50)     DEFAULT NULL                COMMENT 'ISRC编码',
    cover_url       VARCHAR(255)    DEFAULT NULL                COMMENT '封面URL',
    audio_url       VARCHAR(255)    DEFAULT NULL                COMMENT '音频文件URL',
    lyric           TEXT            DEFAULT NULL                COMMENT '歌词',
    play_count      BIGINT          NOT NULL DEFAULT 0          COMMENT '总播放量(冗余)',
    audit_status    TINYINT         NOT NULL DEFAULT 0          COMMENT '审核状态: 0待审核 / 1审核通过 / 2已驳回 / 3已上架 / 4已下架',
    auditor_id      BIGINT          DEFAULT NULL                COMMENT '审核人ID',
    audit_time      DATETIME        DEFAULT NULL                COMMENT '审核时间',
    audit_remark    VARCHAR(500)    DEFAULT NULL                COMMENT '审核备注/驳回原因',
    audio_fingerprint VARCHAR(100)  DEFAULT NULL                COMMENT '音频指纹',
    release_date    DATE            DEFAULT NULL                COMMENT '发行日期',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_song_singer (singer_id),
    INDEX idx_song_style (style),
    INDEX idx_song_audit (audit_status),
    INDEX idx_song_title (title),
    INDEX idx_song_play (play_count DESC),
    INDEX idx_song_release (release_date),
    CONSTRAINT fk_song_singer FOREIGN KEY (singer_id) REFERENCES singer(id) ON DELETE RESTRICT,
    CONSTRAINT fk_song_auditor FOREIGN KEY (auditor_id) REFERENCES sys_user(id) ON DELETE SET NULL
) ENGINE=InnoDB COMMENT='歌曲';

-- 8. 歌曲版权表 (与歌曲一对一)
CREATE TABLE song_copyright (
    id                BIGINT        PRIMARY KEY AUTO_INCREMENT  COMMENT '版权ID',
    song_id           BIGINT        NOT NULL UNIQUE             COMMENT '歌曲ID(一对一)',
    lyric_author      VARCHAR(100)  DEFAULT NULL                COMMENT '作词人',
    composer          VARCHAR(100)  DEFAULT NULL                COMMENT '作曲人',
    copyright_company VARCHAR(200)  DEFAULT NULL                COMMENT '版权公司',
    license_start     DATE          DEFAULT NULL                COMMENT '授权开始日期',
    license_end       DATE          DEFAULT NULL                COMMENT '授权结束日期',
    status            TINYINT       NOT NULL DEFAULT 0          COMMENT '版权状态: 0待录入 / 1已授权 / 2即将到期 / 3已过期',
    created_at        DATETIME      NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at        DATETIME      NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_copyright_status (status),
    INDEX idx_copyright_expire (license_end),
    CONSTRAINT fk_copyright_song FOREIGN KEY (song_id) REFERENCES song(id) ON DELETE CASCADE
) ENGINE=InnoDB COMMENT='歌曲版权信息';

-- 9. 歌单表
CREATE TABLE playlist (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT  COMMENT '歌单ID',
    name            VARCHAR(200)    NOT NULL                    COMMENT '歌单名称',
    cover_url       VARCHAR(255)    DEFAULT NULL                COMMENT '封面URL',
    description     TEXT            DEFAULT NULL                COMMENT '歌单描述',
    type            TINYINT         NOT NULL DEFAULT 0          COMMENT '类型: 0官方歌单 / 1用户歌单',
    creator_id      BIGINT          DEFAULT NULL                COMMENT '创建者ID',
    creator_name    VARCHAR(50)     DEFAULT NULL                COMMENT '创建者名称(冗余)',
    status          TINYINT         NOT NULL DEFAULT 0          COMMENT '状态: 0待审核 / 1已发布 / 2已驳回 / 3已下架',
    publish_time    DATETIME        DEFAULT NULL                COMMENT '发布时间',
    is_pinned       TINYINT         NOT NULL DEFAULT 0          COMMENT '置顶: 0否 / 1是',
    song_count      INT             NOT NULL DEFAULT 0          COMMENT '歌曲数量(冗余)',
    favorite_count  INT             NOT NULL DEFAULT 0          COMMENT '收藏数量(冗余)',
    play_count      BIGINT          NOT NULL DEFAULT 0          COMMENT '播放总量(冗余)',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_playlist_type (type),
    INDEX idx_playlist_status (status),
    INDEX idx_playlist_pinned (is_pinned),
    INDEX idx_playlist_name (name),
    CONSTRAINT fk_playlist_creator FOREIGN KEY (creator_id) REFERENCES sys_user(id) ON DELETE SET NULL
) ENGINE=InnoDB COMMENT='歌单';

-- 10. 歌单-歌曲关联表 (多对多)
CREATE TABLE playlist_song (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT,
    playlist_id     BIGINT          NOT NULL,
    song_id         BIGINT          NOT NULL,
    sort_order      INT             NOT NULL DEFAULT 0          COMMENT '排序序号',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY uk_playlist_song (playlist_id, song_id),
    INDEX idx_ps_song (song_id),
    CONSTRAINT fk_ps_playlist FOREIGN KEY (playlist_id) REFERENCES playlist(id) ON DELETE CASCADE,
    CONSTRAINT fk_ps_song FOREIGN KEY (song_id) REFERENCES song(id) ON DELETE CASCADE
) ENGINE=InnoDB COMMENT='歌单歌曲关联';

-- ============================================================
-- 第三部分：终端用户模块
-- ============================================================

-- 11. 终端用户表
CREATE TABLE app_user (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT  COMMENT '用户ID',
    nickname        VARCHAR(50)     DEFAULT NULL                COMMENT '昵称',
    phone           VARCHAR(20)     DEFAULT NULL UNIQUE         COMMENT '手机号(唯一)',
    password        VARCHAR(255)    DEFAULT NULL                COMMENT '加密密码',
    avatar          TEXT            DEFAULT NULL                COMMENT '头像(支持dataURI)',
    user_type       TINYINT         NOT NULL DEFAULT 0          COMMENT '用户类型: 0普通用户 / 1VIP会员 / 2音乐人',
    vip_expire      DATETIME        DEFAULT NULL                COMMENT 'VIP到期时间',
    status          TINYINT         NOT NULL DEFAULT 1          COMMENT '账号状态: 0已禁用 / 1正常 / 2待激活',
    favorite_count  INT             NOT NULL DEFAULT 0          COMMENT '收藏数量(冗余)',
    playlist_count  INT             NOT NULL DEFAULT 0          COMMENT '歌单数量(冗余)',
    registered_at   DATETIME        DEFAULT NULL                COMMENT '注册时间',
    last_login_at   DATETIME        DEFAULT NULL                COMMENT '最后登录时间',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_app_user_type (user_type),
    INDEX idx_app_user_status (status),
    INDEX idx_app_user_phone (phone),
    INDEX idx_app_user_register (registered_at)
) ENGINE=InnoDB COMMENT='终端用户';

-- 12. 用户收藏表
CREATE TABLE user_favorite (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT,
    user_id         BIGINT          NOT NULL                    COMMENT '用户ID',
    target_type     TINYINT         NOT NULL                    COMMENT '收藏类型: 0歌曲 / 1歌单 / 2歌手',
    target_id       BIGINT          NOT NULL                    COMMENT '收藏目标ID',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY uk_user_fav (user_id, target_type, target_id),
    INDEX idx_fav_target (target_type, target_id),
    CONSTRAINT fk_fav_user FOREIGN KEY (user_id) REFERENCES app_user(id) ON DELETE CASCADE
) ENGINE=InnoDB COMMENT='用户收藏';

-- ============================================================
-- 第四部分：数据统计模块
-- ============================================================

-- 13. 歌曲每日播放统计
CREATE TABLE song_play_stat (
    id                BIGINT        PRIMARY KEY AUTO_INCREMENT,
    song_id           BIGINT        NOT NULL,
    play_date         DATE          NOT NULL                    COMMENT '统计日期',
    play_count        BIGINT        NOT NULL DEFAULT 0          COMMENT '当日播放量',
    unique_listeners  INT           NOT NULL DEFAULT 0          COMMENT '当日独立听众数',
    UNIQUE KEY uk_song_date (song_id, play_date),
    INDEX idx_sps_date (play_date),
    CONSTRAINT fk_sps_song FOREIGN KEY (song_id) REFERENCES song(id) ON DELETE CASCADE
) ENGINE=InnoDB COMMENT='歌曲每日播放统计';

-- 14. 风格播放统计
CREATE TABLE style_play_stat (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT,
    style           VARCHAR(20)     NOT NULL                    COMMENT '音乐风格',
    stat_date       DATE            NOT NULL                    COMMENT '统计日期',
    play_count      BIGINT          NOT NULL DEFAULT 0          COMMENT '当日播放量',
    song_count      INT             NOT NULL DEFAULT 0          COMMENT '当日歌曲数',
    UNIQUE KEY uk_style_date (style, stat_date),
    INDEX idx_sps_style_date (stat_date)
) ENGINE=InnoDB COMMENT='风格播放统计';

-- ============================================================
-- 第五部分：日志与审计模块
-- ============================================================

-- 15. 操作审计日志
CREATE TABLE operation_log (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT  COMMENT '日志ID',
    operator_id     BIGINT          DEFAULT NULL                COMMENT '操作人ID',
    operator_name   VARCHAR(50)     DEFAULT NULL                COMMENT '操作人姓名(冗余)',
    ip_address      VARCHAR(50)     DEFAULT NULL                COMMENT '操作IP',
    op_type         VARCHAR(20)     NOT NULL                    COMMENT '操作类型: ADD/EDIT/DELETE/LOGIN/AUDIT/EXPORT',
    module          VARCHAR(30)     NOT NULL                    COMMENT '操作模块: 歌曲管理/歌手管理/歌单管理/用户管理/系统',
    detail          VARCHAR(500)    DEFAULT NULL                COMMENT '操作详情',
    result          TINYINT         NOT NULL DEFAULT 1          COMMENT '操作结果: 0失败 / 1成功',
    fail_reason     VARCHAR(500)    DEFAULT NULL                COMMENT '失败原因',
    request_params  TEXT            DEFAULT NULL                COMMENT '请求参数',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_log_operator (operator_id),
    INDEX idx_log_type (op_type),
    INDEX idx_log_module (module),
    INDEX idx_log_result (result),
    INDEX idx_log_time (created_at DESC),
    CONSTRAINT fk_log_operator FOREIGN KEY (operator_id) REFERENCES sys_user(id) ON DELETE SET NULL
) ENGINE=InnoDB COMMENT='操作审计日志';

-- 16. 推荐引擎日志
CREATE TABLE recommendation_log (
    id              BIGINT          PRIMARY KEY AUTO_INCREMENT  COMMENT '日志ID',
    user_id         BIGINT          NOT NULL                    COMMENT '用户ID',
    song_id         BIGINT          NOT NULL                    COMMENT '推荐歌曲ID',
    strategy        VARCHAR(50)     NOT NULL                    COMMENT '推荐策略: 协同过滤/内容推荐/热门推荐',
    result          VARCHAR(20)     NOT NULL                    COMMENT '用户反馈: 点击/收藏/分享/忽略',
    score           DECIMAL(5,4)    DEFAULT NULL                COMMENT '推荐评分(0~1)',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_rec_user (user_id),
    INDEX idx_rec_song (song_id),
    INDEX idx_rec_strategy (strategy),
    INDEX idx_rec_time (created_at DESC),
    CONSTRAINT fk_rec_user FOREIGN KEY (user_id) REFERENCES app_user(id) ON DELETE CASCADE,
    CONSTRAINT fk_rec_song FOREIGN KEY (song_id) REFERENCES song(id) ON DELETE CASCADE
) ENGINE=InnoDB COMMENT='推荐引擎日志';

