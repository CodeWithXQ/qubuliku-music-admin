/* ============================================
   曲不离库·歌手小程序 — 全局设计系统
   基于 pages/distribution 的实际运行设计规范
   统一所有 10 个页面的视觉语言
   ============================================ */

/* ---- 全局 reset ---- */
page {
  margin: 0; padding: 0;
  background: transparent;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
  overflow-x: hidden;
}

button {
  padding: 0; margin: 0; border: none; outline: none;
  background: transparent; line-height: inherit;
  font-size: inherit; color: inherit; text-align: inherit;
  box-sizing: border-box; border-radius: 0;
}
button::after { border: none; }

view, text, image, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* ---- 设计令牌 ---- */
page {
  /* 品牌色 — 金色 */
  --gold:          #fcf1c0;
  --gold-dark:     #fed17c;
  --gold-deep:     #c9a83a;

  /* 暗色底 */
  --dark:          #1a1a1a;
  --dark-card:     #2a2a2a;
  --dark-card2:    #1f1f1f;

  /* 白/灰面 */
  --white:         #ffffff;
  --gray-bg:       #f8f8f8;
  --gray-light:    #f0f0f0;
  --gray-border:   #e8e8e8;

  /* 文字 */
  --text-dark:     #333333;
  --text-mid:      #666666;
  --text-dim:      #999999;
  --text-white:    #ffffff;

  /* 功能色 */
  --primary:       #1a1a1a;
  --primary-light: rgba(26,26,26,0.08);
  --primary-shadow:rgba(26,26,26,0.35);
  --warning:       #ff6b6b;
  --danger:        #ff4444;
  --success:       #16A34A;
  --wechat:        #07c160;

  /* 圆角 */
  --radius-sm:     12rpx;
  --radius:        16rpx;
  --radius-lg:     24rpx;
  --radius-xl:     30rpx;
  --radius-full:   50rpx;

  /* 间距 */
  --gap-xs:        8rpx;
  --gap-sm:        16rpx;
  --gap:           20rpx;
  --gap-lg:        30rpx;

  /* 字号 */
  --font-xxl:      72rpx;
  --font-xl:       40rpx;
  --font-lg:       32rpx;
  --font:          28rpx;
  --font-sm:       24rpx;
  --font-xs:       20rpx;

  /* 阴影 */
  --shadow-card:   0 4rpx 20rpx rgba(0,0,0,0.08);
  --shadow-dark:   0 8rpx 32rpx rgba(0,0,0,0.4);
  --shadow-gold:   0 4rpx 16rpx rgba(252,241,192,0.3);

  /* 渐变 */
  --grad-dark:     linear-gradient(135deg, #2a2a2a 0%, #1f1f1f 100%);
}

/* ---- 页面基类：深色渐变顶部 + 白色主体 ---- */
.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: linear-gradient(180deg, var(--dark) 0%, var(--white) 35%);
}

/* ---- 白色卡片 ---- */
.section {
  margin: var(--gap-lg) var(--gap-lg);
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: var(--gap-lg);
  box-shadow: var(--shadow-card);
}

/* ---- 灰色卡片 ---- */
.section-gray {
  background: var(--gray-bg);
  border-radius: var(--radius-lg);
  padding: var(--gap-lg);
  margin: var(--gap-lg) var(--gap-lg);
  border: 1rpx solid var(--gray-border);
}

/* ---- 深色卡片 ---- */
.section-dark {
  background: var(--grad-dark);
  border-radius: var(--radius-lg);
  padding: var(--gap-lg);
  margin: var(--gap-lg) var(--gap-lg);
  box-shadow: var(--shadow-dark);
}

/* ---- 区块标题行 ---- */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-dark);
}
.section-more {
  font-size: var(--font-sm);
  color: var(--text-dim);
}

/* ---- 用户信息头部 —— 深色区域 ---- */
.header-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0 20rpx;
  color: var(--text-white);
}
.header-left {
  display: flex;
  align-items: center;
  gap: var(--gap);
  padding-left: var(--gap-lg);
  flex: 1;
  min-width: 0;
}
.header-avatar {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid var(--gold);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
  background: var(--dark-card);
}
.header-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gold);
}
.header-sub {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.6);
  margin-top: 4rpx;
}

/* ---- 认证等级标签 ---- */
.level-badge {
  font-size: var(--font-xs);
  color: var(--gold);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-xl);
  background: var(--dark-card);
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-weight: 500;
}
.level-badge::before { content: '◆'; font-size: 18rpx; color: var(--gold); }

/* ---- 统计卡片 ---- */
.stat-grid {
  display: flex;
  justify-content: space-between;
  padding-top: var(--gap-lg);
  border-top: 1rpx solid rgba(255,255,255,0.1);
}
.stat-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--gold);
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}
.stat-num.warning { color: var(--warning); }
.stat-label {
  font-size: var(--font-xs);
  color: var(--gold);
  opacity: 0.8;
}

/* ---- 操作网格 ---- */
.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap-sm);
  padding: var(--gap-lg);
}
.action-item {
  background: var(--white);
  border-radius: var(--radius);
  padding: 28rpx 12rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s;
}
.action-item:active { transform: scale(0.95); }
.action-icon { font-size: 44rpx; display: block; }
.action-text { font-size: var(--font-xs); color: var(--text-dim); margin-top: 8rpx; }

/* ---- 歌曲行 ---- */
.song-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--gray-light);
  gap: var(--gap);
}
.song-row:last-child { border-bottom: none; }
.song-row:active { background: var(--gray-bg); }
.song-cover {
  width: 80rpx; height: 80rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--gray-light);
}
.song-info { flex: 1; min-width: 0; }
.song-title {
  font-size: var(--font);
  font-weight: 600;
  color: var(--text-dark);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.song-sub {
  font-size: var(--font-xs);
  color: var(--text-dim);
  margin-top: 4rpx;
}

/* ---- 状态标签 ---- */
.song-status {
  flex-shrink: 0;
  font-size: var(--font-xs);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-xl);
  font-weight: 500;
}
.status-0 { background: #fff7ec; color: var(--gold-deep); }
.status-1 { background: rgba(74,144,217,0.1); color: #4A90D9; }
.status-2 { background: rgba(255,107,107,0.1); color: var(--danger); }
.status-3 { background: rgba(22,163,74,0.1); color: var(--success); }
.status-4 { background: var(--gray-bg); color: var(--text-dim); }

/* ---- 认证提示条 ---- */
.cert-tip {
  margin: 0 var(--gap-lg);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  background: rgba(252,241,192,0.15);
  border: 1rpx solid rgba(252,241,192,0.25);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--gold);
}
.cert-tip-link { color: var(--gold-dark); font-weight: 600; }

/* ---- 表单 ---- */
.form-card {
  background: var(--white);
  margin: var(--gap-lg);
  border-radius: var(--radius-lg);
  padding: var(--gap-lg);
  box-shadow: var(--shadow-card);
}
.form-item { margin-bottom: 24rpx; }
.form-item:last-child { margin-bottom: 0; }
.form-label {
  font-size: var(--font);
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 12rpx;
  display: block;
}
.form-input {
  width: 100%; height: 80rpx;
  background: var(--gray-bg);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: var(--font);
  color: var(--text-dark);
}
.form-textarea {
  width: 100%; min-height: 160rpx;
  background: var(--gray-bg);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
  font-size: var(--font);
  color: var(--text-dark);
}

/* ---- 提交按钮 ---- */
.submit-btn {
  margin: var(--gap-lg) var(--gap-lg);
  height: 88rpx;
  background: var(--primary);
  color: var(--white);
  border-radius: var(--radius-xl);
  font-size: var(--font);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-btn:active { opacity: 0.85; }

/* ---- Tab 切换（胶囊样式） ---- */
.tab-bar {
  display: flex; gap: 0;
  margin-bottom: var(--gap-lg);
  background: var(--gray-bg);
  border-radius: var(--radius-full);
  padding: 6rpx;
}
.tab-item {
  flex: 1; display: flex;
  align-items: center; justify-content: center;
  padding: 12rpx 0;
  border-radius: var(--radius-full);
  background: transparent;
  font-size: var(--font-sm); color: var(--text-dim); font-weight: 500;
  transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
}
.tab-item.active {
  background: var(--gold-dark);
  color: var(--text-dark); font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(254,209,124,0.4);
  transform: scale(1.02);
}

/* ---- 空状态 ---- */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-dim);
  font-size: 26rpx;
}

/* ---- 按钮组 ---- */
.btn-group { display: flex; gap: var(--gap); padding: var(--gap); }
.btn-primary {
  flex: 1; height: 84rpx; background: var(--primary); color: var(--white);
  border-radius: var(--radius-xl); font-size: var(--font); font-weight: 600;
}
.btn-secondary {
  flex: 1; height: 84rpx; background: var(--gray-bg); color: var(--text-dim);
  border-radius: var(--radius-xl); font-size: var(--font);
}

/* ---- 信息行 ---- */
.info-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--gray-light);
}
.info-row:last-child { border-bottom: none; }
.info-label { font-size: var(--font); color: var(--text-dim); min-width: 120rpx; flex-shrink: 0; }
.info-value { font-size: var(--font); color: var(--text-dark); flex: 1; text-align: right; }

/* ---- 底部分割 ---- */
.footer-placeholder { height: 40rpx; }
