/* 自定义 TabBar — 高度 110rpx */

.tabbar {
  display: flex;
  height: 110rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
}

.tabbar-text {
  font-size: 20rpx;
  color: #8a8a8a;
  line-height: 1;
}

.tabbar-text.active {
  color: #c9a83a;
}
