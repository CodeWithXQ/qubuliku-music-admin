<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tabbar-item"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image class="tabbar-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
    <text class="tabbar-text {{selected === index ? 'active' : ''}}">{{item.text}}</text>
  </view>
</view>
