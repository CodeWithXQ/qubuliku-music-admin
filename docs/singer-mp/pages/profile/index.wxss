/* pages/profile — 头像样式（保持原样）*/

.profile-avatar-img {
  width: 152rpx; height: 152rpx; border-radius: 50%;
  background: var(--dark-card); border: 4rpx solid var(--gold);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2);
}

/* ===== 按钮（仅修改项）===== */

/* 保存修改 */
.profile-save-btn {
  flex: 1;
  height: 84rpx;
  background: #1a1a1a;
  color: #fcf1c0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.profile-save-btn::after { border: none; }
.profile-save-btn:active { opacity: 0.85; }

/* 取消 */
.profile-cancel-btn {
  flex: 1;
  height: 84rpx;
  background: #f2f3f5;
  color: #666;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.profile-cancel-btn::after { border: none; }
.profile-cancel-btn:active { background: #e5e6e8; }

/* 退出登录 */
.profile-logout-btn {
  width: 100%;
  height: 84rpx;
  background: #fff;
  color: #d44;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 1rpx solid rgba(220, 68, 68, 0.15);
}
.profile-logout-btn::after { border: none; }
.profile-logout-btn:active { background: #fff5f5; }
