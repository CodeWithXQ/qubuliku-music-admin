/* ============================================
   消息列表 — 现代小程序风格
   ============================================ */

.msg-page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---- 空状态 ---- */
.msg-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 280rpx;
}
.msg-empty-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  opacity: 0.3;
  margin-bottom: 32rpx;
}
.msg-empty-title  { font-size: 30rpx; font-weight: 600; color: #333; }
.msg-empty-desc   { font-size: 24rpx; color: #999; margin-top: 12rpx; }

/* ---- 列表 ---- */
.msg-list {
  padding: 20rpx 24rpx;
}

/* ---- 卡片 ---- */
.msg-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.12s;
}
.msg-card:active {
  transform: scale(0.985);
  background: #fafafa;
}

.msg-card--unread {
  background: #fffefa;
  box-shadow: 0 2rpx 12rpx rgba(201, 168, 58, 0.12);
}

/* ---- 头像 ---- */
.msg-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.msg-avatar--song_audit    { background: #edf0ff; }
.msg-avatar--certification { background: #fff3e0; }
.msg-avatar--copyright     { background: #ffeaea; }
.msg-avatar--system        { background: #e6f3ef; }

.msg-avatar-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
}

/* ---- 内容 ---- */
.msg-info  { flex: 1; min-width: 0; }
.msg-top   { display: flex; align-items: center; gap: 8rpx; }
.msg-title { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }

.msg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #ff3b30;
  flex-shrink: 0;
}

.msg-desc {
  font-size: 26rpx;
  color: #777;
  line-height: 1.5;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.msg-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.msg-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.msg-tag--song_audit    { background: #edf0ff; color: #4a60d4; }
.msg-tag--certification { background: #fff3e0; color: #e8963e; }
.msg-tag--copyright     { background: #ffeaea; color: #d44; }
.msg-tag--system        { background: #e6f3ef; color: #3a8; }

.msg-time {
  font-size: 22rpx;
  color: #bbb;
}

.msg-loading {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}
