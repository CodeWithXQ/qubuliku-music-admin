<view class="chat-page" wx:if="{{item}}">
  <!-- 时间戳 -->
  <view class="chat-time">
    <text class="chat-time-text">{{formatTime(item.createdAt)}}</text>
  </view>

  <!-- 消息气泡 -->
  <view class="chat-msg">
    <!-- 头像 -->
    <image class="chat-avatar-img" src="/images/余音绕梁Logo设计.png" mode="aspectFill" />

    <!-- 气泡 -->
    <view class="chat-bubble">
      <view class="chat-bubble-arrow"></view>
      <text class="chat-sender">曲不离库·系统通知</text>
      <text class="chat-title">{{item.title}}</text>
      <text class="chat-body">{{item.content}}</text>
      <view class="chat-footer">
        <text class="chat-type-tag chat-type-tag--{{item.type}}">{{typeLabel(item.type)}}</text>
      </view>
    </view>
  </view>

  <!-- 关联操作 -->
  <view class="chat-action-card" wx:if="{{item.relatedId}}" bindtap="goRelated">
    <view class="chat-action-left">
      <image class="chat-action-icon-img" src="/images/余音绕梁Logo设计.png" mode="aspectFill" />
      <view class="chat-action-info">
        <text class="chat-action-title">{{item.type === 'song_audit' ? '查看歌曲详情' : item.type === 'certification' ? '查看认证状态' : '查看关联内容'}}</text>
        <text class="chat-action-sub">点击查看 →</text>
      </view>
    </view>
    <text class="chat-action-arrow">›</text>
  </view>
</view>
