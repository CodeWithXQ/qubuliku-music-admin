/* pages/distribution/balance-log/balance-log.wxss */

/* ==================== 全局样式 ==================== */
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ==================== 储值金余额概览 ==================== */
.balance-overview {
  background: #1c1c1c;
  padding: 10rpx 30rpx 30rpx;
  margin-bottom: 20rpx;
}

.balance-header {
  margin-bottom: 2rpx;
}

.balance-label {
  font-size: 26rpx;
  color: #fcf1c0;
}

.balance-amount {
  font-size: 72rpx;
  font-weight: 800;
  color: #fcf1c0;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  letter-spacing: -2rpx;
  margin-bottom: 30rpx;
}

.balance-stats {
  display: flex;
  align-items: center;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #fcf1c0;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}

.stat-divider {
  width: 2rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* ==================== Tab筛选栏 ==================== */
.tab-bar {
  display: flex;
  gap: 0;
  margin: 0 30rpx 30rpx;
  background: #fff7ec;
  border-radius: 12rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  background: transparent;
  transition: all 0.3s ease;
}

.tab-text {
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #fed17c;
  box-shadow: 0 2rpx 8rpx rgba(254, 209, 124, 0.3);
}

.tab-item.active .tab-text {
  color: #333333;
  font-weight: 600;
}

/* ==================== 流水记录列表 ==================== */
.log-list {
  padding: 0 30rpx;
}

.log-item {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 时间轴 */
.log-timeline {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  position: relative;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #e0e0e0;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.timeline-dot.income {
  background: #52c41a;
  box-shadow: 0 0 0 4rpx rgba(82, 196, 26, 0.2);
}

.timeline-dot.consume {
  background: #ff4d4f;
  box-shadow: 0 0 0 4rpx rgba(255, 77, 79, 0.2);
}

.timeline-dot.expired {
  background: #faad14;
  box-shadow: 0 0 0 4rpx rgba(250, 173, 20, 0.2);
}

.timeline-dot.adjust {
  background: #1890ff;
  box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.2);
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  background: #e8e8e8;
  margin-top: 8rpx;
}

/* 记录内容 */
.log-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.log-type.income {
  color: #52c41a;
}

.log-type.consume {
  color: #ff4d4f;
}

.log-type.expired {
  color: #faad14;
}

.log-type.adjust {
  color: #1890ff;
}

.log-time {
  font-size: 24rpx;
  color: #999999;
}

.log-body {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.log-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.log-remark {
  font-size: 26rpx;
  color: #666666;
}

.log-source {
  font-size: 22rpx;
  color: #999999;
}

.log-amount-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.log-amount {
  font-size: 32rpx;
  font-weight: 700;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}

.log-amount.income {
  color: #52c41a;
}

.log-amount.expense {
  color: #ff4d4f;
}

.log-balance {
  font-size: 22rpx;
  color: #999999;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  color: #e0e0e0;
  margin-bottom: 20rpx;
}

.empty-icon::before {
  content: '📋';
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* ==================== 加载提示 ==================== */
.loading-tip {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999999;
}

/* ==================== 没有更多 ==================== */
.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #cccccc;
}
