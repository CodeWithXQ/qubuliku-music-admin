/* pages/distribution/referral-list/referral-list.wxss */

/* ==================== 全局样式 ==================== */
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ==================== 顶部统计卡片 ==================== */
.stats-card {
  background: #1c1c1c;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stats-title {
  font-size: 28rpx;
  color: #fcf1c0;
  margin-bottom: 24rpx;
  font-weight: 600;
}

.stats-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}

.stat-value.highlight {
  color: #fcf1c0;
}

.stat-value.gold {
  color: #ffd700;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* ==================== Tab筛选栏 ==================== */
.tab-bar {
  display: flex;
  gap: 0;
  margin-bottom: 30rpx;
  background: #fff7ec;
  border-radius: 12rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  background: transparent;
  transition: all 0.3s ease;
}

.tab-text {
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-item.active .tab-text {
  color: #333333;
  font-weight: 600;
}

.tab-item.active {
  background: #fed17c;
  box-shadow: 0 2rpx 8rpx rgba(254, 209, 124, 0.3);
}

/* ==================== 推广明细列表 ==================== */
.referral-list {
  padding: 0 30rpx;
}

.referral-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.referral-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* 左侧：服务图片 */
.service-image-wrapper {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.service-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.status-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
}

.status-badge.completed {
  background: rgba(82, 196, 26, 0.9);
}

.status-badge.pending {
  background: rgba(250, 173, 20, 0.9);
}

.status-badge.refunded {
  background: rgba(245, 34, 45, 0.9);
}

/* 中间：订单信息 */
.order-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.customer-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.customer-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.customer-name {
  font-size: 28rpx;
  color: #1c1c1c;
  font-weight: 600;
  flex-shrink: 0;
}

.order-time {
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.service-name {
  font-size: 26rpx;
  color: #333333;
}

.order-id {
  font-size: 22rpx;
  color: #999999;
}

/* 右侧：金额信息 */
.amount-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.commission-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.commission-label {
  font-size: 22rpx;
  color: #999999;
}

.commission-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #52c41a;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}

.rate-badge {
  padding: 4rpx 12rpx;
  background: linear-gradient(90deg, #fff7e6 0%, #ffe7ba 100%);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fa8c16;
  font-weight: 600;
}

.order-amount-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.order-amount-label {
  font-size: 22rpx;
  color: #999999;
}

.order-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.empty-tip {
  font-size: 24rpx;
  color: #cccccc;
  text-align: center;
  max-width: 400rpx;
}

/* ==================== 加载状态 ==================== */
.loading-more {
  padding: 40rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 24rpx;
  color: #999999;
}

.no-more {
  padding: 40rpx 0;
  text-align: center;
}

.no-more-text {
  font-size: 24rpx;
  color: #cccccc;
}
