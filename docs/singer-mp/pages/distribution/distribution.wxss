}

.welcome-close-text {
  color: #fff;
  font-size: 36rpx;
  line-height: 64rpx;
}

/* 弹窗主体 */
.welcome-modal-body {
  position: relative;
  background: linear-gradient(180deg, #FFFBF0 0%, #F8F4FF 40%, #F0EBFA 100%);
  border-radius: 48rpx;
  overflow: hidden;
  padding: 0 48rpx 64rpx;
  text-align: center;
}

/* 背景装饰色块 - 淡紫色光晕 */
.welcome-modal-body::before {
  content: '';
  position: absolute;
  top: 40%;
  left: -20%;
  width: 140%;
  height: 60%;
  background: radial-gradient(ellipse at center, rgba(200, 180, 240, 0.25) 0%, transparent 70%);
  pointer-events: none;
}

/* 插画区域 */
.welcome-illustration {
  position: relative;
  width: 100%;
  height: 400rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.welcome-illustration-img {
  width: 100%;
  height: 100%;
}

/* 文字区域 */
.welcome-text-area {
  position: relative;
  z-index: 1;
}

.welcome-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.welcome-subtitle {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 48rpx;
  padding: 0 16rpx;
}

/* CTA 按钮 */
.welcome-cta-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 400rpx;
  margin: 0 auto;
  padding: 28rpx 0;
