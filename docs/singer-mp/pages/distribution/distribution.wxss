  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.welcome-cta-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.welcome-cta-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}

/* 折叠角 */
.welcome-folded-corner {
  position: absolute;
  bottom: -4rpx;
  left: -4rpx;
  width: 140rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #C8B8E0 0%, #B8A8D8 100%);
  border-radius: 0 0 0 48rpx;
  box-shadow: 
    4rpx -4rpx 12rpx rgba(0, 0, 0, 0.08),
    inset -2rpx 2rpx 4rpx rgba(255, 255, 255, 0.3);
  z-index: 5;
}

/* 折叠角的白色折痕线 */
.welcome-folded-corner::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 0 96rpx 136rpx;
  border-color: transparent transparent transparent rgba(255, 255, 255, 0.25);
}

/* 底部阴影层 */
.welcome-paper-shadow {
  position: absolute;
  bottom: -12rpx;
  left: 12rpx;
  right: 12rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.15);
  border-radius: 48rpx;
  z-index: -1;
}