<view class="login">
  <!-- 品牌 -->
  <view class="login-hero">
    <image class="login-logo" src="/images/余音绕梁Logo设计.png" mode="aspectFit" />
    <text class="login-name">曲不离库</text>
    <text class="login-desc">音乐人认证入驻平台</text>
  </view>

  <!-- 卡片 -->
  <view class="login-card">
    <!-- 手机号登录 -->
    <view class="login-phone">
      <input class="login-input" type="number" maxlength="11" placeholder="手机号" value="{{phone}}" bindinput="onPhoneInput" />
      <view class="login-phone-row">
        <input class="login-input login-code" type="number" maxlength="6" placeholder="验证码" value="{{code}}" bindinput="onCodeInput" />
        <view class="login-sms-btn {{smsCountdown > 0 ? 'login-sms-btn--disabled' : ''}}" bindtap="{{smsCountdown > 0 ? '' : 'sendSms'}}">
          {{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}
        </view>
      </view>
      <view class="login-btn-phone" bindtap="onPhoneLogin">{{loading ? '登录中...' : '登录'}}</view>
    </view>
  </view>

  <!-- 协议 -->
  <view class="login-agree">
    <text>登录即表示同意 </text><text class="login-agree-link">《用户协议》</text>
    <text> 和 </text><text class="login-agree-link">《隐私政策》</text>
  </view>
</view>
