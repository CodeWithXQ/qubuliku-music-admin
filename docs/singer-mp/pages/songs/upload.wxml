<view class="upload-page">
  <view class="upload-form">
    <view class="form-item">
      <text class="form-label">歌曲名称 *</text>
      <input class="form-input" value="{{form.title}}" data-field="title" bindinput="onInput" placeholder="请输入歌曲名称" />
    </view>
    <view class="form-item">
      <text class="form-label">所属专辑</text>
      <input class="form-input" value="{{form.album}}" data-field="album" bindinput="onInput" placeholder="留空则显示'未命名'" />
    </view>
    <view class="upload-row-2">
      <view class="form-item" style="flex:1">
        <text class="form-label">音乐风格 *</text>
        <picker mode="selector" range="{{styleList}}" value="{{styleIndex}}" bindchange="onStyleChange">
          <view class="form-input" style="line-height:80rpx;color:{{styleIndex >= 0 ? '' : '#ccc'}}">{{styleIndex >= 0 ? styleList[styleIndex] : '请选择风格'}}</view>
        </picker>
      </view>
      <view class="form-item" style="flex:1">
        <text class="form-label">时长(秒) *</text>
        <input class="form-input" type="number" value="{{form.duration}}" data-field="duration" bindinput="onInput" placeholder="如 240" />
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">ISRC编码</text>
      <input class="form-input" value="{{form.isrc}}" data-field="isrc" bindinput="onInput" placeholder="如 CN-A01-23-00456" />
    </view>

    <view class="form-item">
      <text class="form-label">封面图片 *</text>
      <view class="upload-box {{coverUrl ? 'upload-filled' : ''}}" bindtap="chooseCover">
        <image wx:if="{{coverUrl}}" class="upload-preview-img" src="{{coverUrl}}" mode="aspectFill" />
        <block wx:else>
          <text class="upload-box-icon">📷</text>
          <text class="upload-box-text">{{coverUploading ? '上传中...' : '点击上传封面'}}</text>
        </block>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">音频文件 * (MP3/WAV/FLAC, ≤50MB)</text>
      <view class="upload-box" bindtap="chooseAudio">
        <text class="upload-box-icon">🎵</text>
        <text class="upload-box-text">{{audioUploading ? '上传中...' : audioUrl ? '已上传 ✅' : '点击选择音频'}}</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">歌词</text>
      <textarea class="form-textarea" value="{{form.lyric}}" data-field="lyric" bindinput="onInput" placeholder="歌词内容（可选）" />
    </view>

    <view class="form-item">
      <text class="form-label">发行日期</text>
      <picker mode="date" value="{{form.releaseDate}}" data-field="releaseDate" bindchange="onDateChange">
        <view class="form-input" style="line-height:80rpx;color:{{form.releaseDate ? '' : '#ccc'}}">{{form.releaseDate || '选择日期'}}</view>
      </picker>
    </view>

    <view class="form-item" bindtap="toggleCopyright">
      <text class="upload-copyright-toggle">📋 版权信息（选填） {{showCopyright ? '▲' : '▼'}}</text>
      <view wx:if="{{showCopyright}}" class="upload-copyright-body">
        <view class="upload-row-2">
          <view class="form-item" style="flex:1"><text class="form-label form-label-sm">作词人</text><input class="form-input" value="{{form.lyricAuthor}}" data-field="lyricAuthor" bindinput="onInput" placeholder="作词人" /></view>
          <view class="form-item" style="flex:1"><text class="form-label form-label-sm">作曲人</text><input class="form-input" value="{{form.composer}}" data-field="composer" bindinput="onInput" placeholder="作曲人" /></view>
        </view>
        <view class="form-item"><text class="form-label form-label-sm">版权公司</text><input class="form-input" value="{{form.copyrightCompany}}" data-field="copyrightCompany" bindinput="onInput" placeholder="版权公司" /></view>
        <view class="upload-row-2">
          <view class="form-item" style="flex:1"><text class="form-label form-label-sm">授权开始</text><picker mode="date" value="{{form.licenseStart}}" data-field="licenseStart" bindchange="onDateChange"><view class="form-input" style="line-height:80rpx;font-size:24rpx;color:{{form.licenseStart ? '' : '#ccc'}}">{{form.licenseStart || '开始日期'}}</view></picker></view>
          <view class="form-item" style="flex:1"><text class="form-label form-label-sm">授权结束</text><picker mode="date" value="{{form.licenseEnd}}" data-field="licenseEnd" bindchange="onDateChange"><view class="form-input" style="line-height:80rpx;font-size:24rpx;color:{{form.licenseEnd ? '' : '#ccc'}}">{{form.licenseEnd || '结束日期'}}</view></picker></view>
        </view>
      </view>
    </view>
  </view>

  <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}">{{submitting ? '提交中...' : '提交审核'}}</button>
  <view class="upload-footer-tip">提交后将进入审核流程，审核通过后自动上架</view>
  <view class="footer-placeholder"></view>
</view>
