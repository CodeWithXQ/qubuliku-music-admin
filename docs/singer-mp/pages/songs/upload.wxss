/* pages/songs/upload — 深色渐变顶无缝衔接导航栏 */

/* 页面：渐变从 #1a1a1a 起始，与导航栏同色 */
.upload-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a1a 0%, #1a1a1a 120rpx, #f5f5f7 300rpx, #f5f5f7 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 表单卡片：去除顶部留白，直接贴合 */
.upload-form {
  background: #fff;
  margin: 0 24rpx 0;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
}

/* 表单行 */
.upload-row-2 {
  display: flex;
  gap: 20rpx;
}

/* 小标签 */
.form-label-sm {
  font-size: 24rpx;
  font-weight: 500;
}

/* 上传区域 */
.upload-box {
  width: 200rpx;
  height: 200rpx;
  background: #f7f5f0;
  border-radius: 16rpx;
  border: 2rpx dashed #e0dbd0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.upload-box.upload-filled {
  border-style: solid;
  border-color: #c9a83a;
}
.upload-preview-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
}
.upload-box-icon {
  font-size: 56rpx;
}
.upload-box-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 版权折叠 */
.upload-copyright-toggle {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.upload-copyright-body {
  margin-top: 16rpx;
}

/* 提交按钮 */
.upload-page .submit-btn {
  margin: 28rpx 24rpx;
  height: 92rpx;
  background: #1a1a1a;
  color: #fcf1c0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}
.upload-page .submit-btn::after { border: none; }
.upload-page .submit-btn:active { opacity: 0.85; }

/* 页脚提示 */
.upload-footer-tip {
  text-align: center;
  padding: 0 24rpx 20rpx;
  font-size: 22rpx;
  color: #bbb;
}
